# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'HyperSDKNewArchTest' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # hyper-sdk-react exposes its HyperSdkReactDelegate protocol via public
    # headers but ships no module map, so Swift AppDelegate conformance
    # ("import hyper_sdk_react") fails. Write one here so pod install doesn't
    # wipe it (same pattern ReactAppDependencyProvider uses).
    module_map = File.join(__dir__, "Pods/Headers/Public/hyper-sdk-react/module.modulemap")
    module_dir = File.dirname(module_map)
    FileUtils.mkdir_p(module_dir)
    File.write(module_map, <<~MODULEMAP)
      module hyper_sdk_react {
          header "HyperSdkReact.h"
          export *
      }
    MODULEMAP

    # HyperSDK asset provisioning - required, mirrors the official example app.
    # Downloads assets into HyperSDK.xcframework (supplies VerifyHyperAssets.h).
    fuse_path = "./Pods/HyperSDK/Fuse.rb"
    clean_assets = true # Pass true to re-download all the assets
    if File.exist?(fuse_path)
      if system("ruby", fuse_path.to_s, clean_assets.to_s)
      end
    end
  end
end
